// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Товары
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  isArchived Boolean   @default(false) @map("is_archived")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  products   Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String?
  status      ProductStatus    @default(ACTIVE)
  categoryId  String           @map("category_id")
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

// Каждый товар имеет хотя бы один вариант; товар без вариантов
// представляется одним вариантом по умолчанию ("Стандарт").
model ProductVariant {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  name         String
  sellingPrice Int      @map("selling_price")
  averageCost  Int      @default(0) @map("average_cost")
  currentStock Int      @default(0) @map("current_stock")
  minStock     Int      @default(0) @map("min_stock")
  isArchived   Boolean  @default(false) @map("is_archived")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockReceipts  StockReceipt[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Склад
// ---------------------------------------------------------------------------

enum StockMovementType {
  INCOMING
  SALE
  RETURN
  ADJUSTMENT
}

enum AdjustmentReason {
  LOST
  DAMAGED
  MISCOUNTED
  OTHER
}

// Приход товара — источник события пополнения склада.
// Себестоимость единицы = цена закупки + (цена упаковки + доп. расходы) / количество.
model StockReceipt {
  id                   String         @id @default(cuid())
  variantId            String         @map("variant_id")
  variant              ProductVariant @relation(fields: [variantId], references: [id])
  quantity             Int
  purchasePricePerUnit Int            @map("purchase_price_per_unit")
  packagingPrice       Int            @default(0) @map("packaging_price")
  additionalCosts      Int            @default(0) @map("additional_costs")
  unitCost             Int            @map("unit_cost")
  receivedAt           DateTime       @default(now()) @map("received_at")
  comment              String?
  createdAt            DateTime       @default(now()) @map("created_at")

  stockMovement StockMovement?

  @@index([variantId])
  @@map("stock_receipts")
}

// Единый неизменяемый журнал каждого изменения остатка.
// Любая операция (приход/продажа/возврат/корректировка) обязана создавать запись здесь.
model StockMovement {
  id               String            @id @default(cuid())
  variantId        String            @map("variant_id")
  variant          ProductVariant    @relation(fields: [variantId], references: [id])
  type             StockMovementType
  quantityChange   Int               @map("quantity_change")
  stockAfter       Int               @map("stock_after")
  costAtMovement   Int               @map("cost_at_movement")
  stockReceiptId   String?           @unique @map("stock_receipt_id")
  stockReceipt     StockReceipt?     @relation(fields: [stockReceiptId], references: [id])
  orderId          String?           @map("order_id")
  order            Order?            @relation(fields: [orderId], references: [id])
  adjustmentReason AdjustmentReason? @map("adjustment_reason")
  comment          String?
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([variantId])
  @@index([orderId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Заказы
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum DeliveryPayer {
  CUSTOMER
  STORE
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  BANK_TRANSFER
  OTHER
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique @map("order_number")
  status         OrderStatus   @default(NEW)
  paymentStatus  PaymentStatus @default(UNPAID) @map("payment_status")
  deliveryPrice  Int           @default(0) @map("delivery_price")
  deliveryPaidBy DeliveryPayer @default(CUSTOMER) @map("delivery_paid_by")
  comment        String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  stockMovements StockMovement[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

// Цена продажи и себестоимость фиксируются на момент создания/продажи заказа
// и не должны меняться при последующем изменении цены товара.
model OrderItem {
  id          String         @id @default(cuid())
  orderId     String         @map("order_id")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String         @map("variant_id")
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  priceAtSale Int            @map("price_at_sale")
  costAtSale  Int            @map("cost_at_sale")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @map("order_id")
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  method    PaymentMethod
  paidAt    DateTime      @default(now()) @map("paid_at")
  comment   String?
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at")
  comment   String?

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Расходы
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  isArchived Boolean   @default(false) @map("is_archived")
  createdAt  DateTime  @default(now()) @map("created_at")
  expenses   Expense[]

  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(cuid())
  categoryId      String          @map("category_id")
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  title           String
  amount          Int
  date            DateTime        @default(now())
  comment         String?
  receiptPhotoUrl String?         @map("receipt_photo_url")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Пользователи
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Настройки
// ---------------------------------------------------------------------------

// Singleton-таблица: в системе должна существовать ровно одна строка настроек.
model StoreSettings {
  id              String   @id @default(cuid())
  storeName       String   @map("store_name")
  logoUrl         String?  @map("logo_url")
  currency        String   @default("UZS")
  defaultMinStock Int      @default(0) @map("default_min_stock")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}
